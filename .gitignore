# 产物与本地环境不入库
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
var/
var/uploads/
# 发行物是本地构建产物（含 wheel/锁文件/校验和），不入库；
# 构建命令见 scripts/build_release.py 与 docs/交付与验收SOP.md
dist/
# 交接包是本地交付产物（含 wheel、签名包、公钥），不入库；
# 交付时整体复制 handoff/<批次>/ 目录，结构见 docs/交付与验收SOP.md §7
handoff/
# 注意：`src/_release_info.py` 是 build_release.py 的临时文件，构建结束即删除，
# 不能写进 .gitignore——hatchling 会按忽略规则把它排除在 wheel 之外。
reports/*.csv
reports/变异测试-现场/
# 第三方盲跑交付物/整改材料属于外部输入，默认不入库
reports/第三方盲跑-*/
# 性能/迁移对照 JSON 是跑出来的临时产物（含本机路径/时点），默认不入库
reports/性能探针-*.json
reports/迁移对照-*.json
.env
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
.DS_Store
.idea/
.vscode/

# 举证包与审计链快照属于「跑出来的证据」，默认不入库；
# README 说明了如何用一条命令重新生成，以及为何不提交（含本机路径与时间戳）
data/raw/MANIFEST.json
