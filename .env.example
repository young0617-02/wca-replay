# worktime-compliance-agent 配置模板
# 用法：cp .env.example .env，然后按 TODO 逐条填写。
# **默认后端是 PostgreSQL 18**：必须填 WCA_DATABASE_URL；留空会在启动期明确报错，
# 不会静默回退 SQLite。无 PostgreSQL 的离线环境请显式改成 SQLite 回退（见下方注释）。
# 说明：本文件是「需要人工填的项」的唯一集中处；文档里不再散落待填项。

# ================================================================== 运行与数据
# 默认 PostgreSQL 18；SQLite 仅作为显式离线回退（WCA_DB_BACKEND=sqlite）。
WCA_DB_BACKEND=postgres
# PostgreSQL 连接串只放本地 .env 或进程环境，禁止提交到仓库。
# 必须指向新建项目库，不要指向活动库 wca_worktime。
# 示例：WCA_DATABASE_URL=postgresql://root:<本地口令>@127.0.0.1:5927/wca_pilot_20261103
WCA_DATABASE_URL=
# PostgreSQL 选中库的本地标记（不含口令）。配置 URL 与它不一致时启动直接失败，
# 不会自动改写 URL 或回落到 identity 指向的库；确认切库请显式执行
# `python -m src.cli db-target --reset --confirm <配置库名>`。
WCA_DB_IDENTITY_PATH=var/db_target.json
# SQLite 回退路径（仅当上面显式设置 WCA_DB_BACKEND=sqlite 时使用）
WCA_DB_PATH=var/worktime.sqlite3
# 离线回退示例（取消下面一行、并把 WCA_DB_BACKEND 改成 sqlite）：
# WCA_DB_BACKEND=sqlite
WCA_DATA_DIR=data
WCA_REPORTS_DIR=reports
WCA_PACKAGES_DIR=var/packages
# 界面账号文件（只存 scrypt 口令哈希）与界面上传 CSV 的落盘目录
WCA_USERS_PATH=config/users.json
WCA_UPLOAD_DIR=var/uploads

# ================================================================== Web 服务（默认端口 9763）
# 监听地址（进程环境变量）：src.api_server 读取 WCA_HOST；服务管理器启动时按
# config/services.json 的 host 注入同名变量（setdefault，不覆盖已有进程环境值）。
# 写在本文件不会自动导出到子进程；用 .env 管理时需由启动器导出，或直接改
# config/services.json。默认只绑本机回环；改成 0.0.0.0/局域网地址时，启动期会检查
# 配置账号文件与数据库 app_user，只要仍有账号能用 wca-demo-* 演示口令就拒绝启动。
# 直接 `uvicorn src.api:app --host 0.0.0.0` 以 CLI 的 --host 为准；请求层按 ASGI
# scope["server"] 的服务端地址再拒绝一次（503）。Host/X-Forwarded-Host 只写日志，
# 不参与放行；scope["server"] 缺失或非法时失败关闭。
WCA_HOST=127.0.0.1
# 反向代理终止 TLS 时必须显式设为 true：让会话 Cookie 带上 Secure（请求 scheme 仍是 http 也生效）。
# 它不会改变 scope["server"] 的绑定判定；Host 只写日志，不参与放行。
WCA_HTTPS_MODE=false
# HSTS：只有真实 HTTPS（请求 scheme=https）且显式 true 才下发；HTTP 部署保持 false。
WCA_HSTS=false

# ================================================================== 范围锁定（方案 §9-R2）
# TODO【填：锁定的城市与工时制】——MVP 只支持 1 个城市 + 1 种工时制的判据分支。
# 当前代码默认值：440300 深圳市 / standard 标准工时制（其余分支保留但未做地域核对，见 docs/口径声明.md）
WCA_REGION_CODE=440300
WCA_REGION_LABEL=深圳市
WCA_WORKTIME_REGIME=standard
# 规则包版本：改动判据必须升版本号，否则举证包三元组会误判为「可复现」
# 默认 v5；v6（REG-01 改读 employee_approval_coverage）为实验性，需显式切换并先确认旧台账已迁移
WCA_RULE_PACK=rp-2026.11.gd-pilot-standard.v5

# ================================================================== 判据口径（可配置，但一改就要重跑评测）
WCA_DAILY_STD_MINUTES=480
WCA_WEEKLY_STD_MINUTES=2400
WCA_WEEKLY_REST_MIN_DAYS=1
WCA_OT_CAP_DAILY_GENERAL_MIN=60
WCA_OT_CAP_DAILY_SPECIAL_MIN=180
WCA_OT_CAP_MONTHLY_MIN=2160
# 36 小时月上限的统计口径：weekday_only | weekday_plus_rest（休息日加班是否计入存在裁口径差异）
WCA_OT_CAP_SCOPE=weekday_only
# 跨零点班次切分：00:00–cut_hour 的打卡归前一工作日。取值必须落在
# [最晚夜班结束时间, 最早早班开始时间) 内。TODO【填：真实排班的夜班结束/早班开始时间】
WCA_CROSS_DAY_CUT_HOUR=7
WCA_NIGHT_WINDOW_START_HOUR=0
WCA_NIGHT_WINDOW_END_HOUR=6
# 加班工资基数来源：contract_normal_wage（合同约定正常工作时间工资，深圳口径）
WCA_PAY_BASE_SOURCE=contract_normal_wage
WCA_EXPORT_ROW_BUDGET=1000
# 导入写入方式：single（默认，逐行 INSERT，行为不变）| executemany / copy（PG 批量路径）。
# REV-32 已修同文件并发、中断回滚、file_id 漂移与 QUAL-DUP 膨胀；REV-33 完成 SQLite 自动降级、
# 分块写入、COPY 中途失败回滚与并发 check 审计串行化。COPY 仍不切默认：更大规模/维护策略未压测。
WCA_IMPORT_WRITE_MODE=single
# 导入分块/批量行数：默认 5000；硬上限 20000。超过上限会截断为 20000 并告警，
# 避免把整文件 payload 重新拉回内存。SQLite 请求 executemany/copy 会自动降级为 single。
WCA_IMPORT_BATCH_SIZE=5000
# 单员工/单文件 QUAL-DUP 超过该条数时汇总为一条（引擎按天展开，结论不变）；
# 0 表示不汇总（逐行存储）。默认 20。
WCA_QUAL_DUP_AGGREGATE_THRESHOLD=20

# ================================================================== 模型（需求 v2.0 决定 3：云 API 为演示档，stub 为复现档）
# stub | ollama | cloud。stub = 离线确定性模板链路，pytest 与评测集默认走它（NFR-19 无凭证可跑）。
# cloud 档要真实凭证才能跑；没有凭证时确定性链路不受影响，问答返回明确降级提示（NFR-08）。
WCA_LLM_PROVIDER=stub
# 单次请求超时（秒）；超时按不可达处理并降级，不静默当成模型答对了
WCA_LLM_TIMEOUT_S=25
# TODO【填：云 API base_url 与 api_key】——密钥只进 .env，不入仓库/日志/举证包（NFR-15）
WCA_CLOUD_BASE_URL=
WCA_CLOUD_API_KEY=
# TODO【填：模型名】——未填前 cloud 档无法启用，默认 stub
WCA_LLM_MODEL=stub-offline-v1
WCA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# TODO【填：月度现金上限】与【填：实际账单】（NFR-13，未取得账单前文档不得出现成本数字）

# ================================================================== 检索
# bm25 | exact | vector。vector 需要本地 embedding 模型；不可用时代码会如实降级为 bm25 并在结果里标注
WCA_EMBEDDING_BACKEND=bm25
# TODO【填：embedding 模型名，如 BGE-M3；以及是否具备显存/磁盘条件】
WCA_EMBEDDING_MODEL=
WCA_RETRIEVAL_TOP_K=5
WCA_MIN_EVIDENCE_COVERAGE_PERMILLE=800
WCA_CONFIDENCE_THRESHOLD_PERMILLE=700
# 红线：无检索结果时不允许凭空生成
WCA_ALLOW_GENERATION_WITHOUT_RETRIEVAL=false

# ================================================================== 人工核对（方案 §9-R1 / B3）
# TODO【填：B3 访谈对象名单与时间】——F-001 字段口径的一手来源。未填则 docs/P0-闸门.md 记为未完成，
# 且 README 与 docs 中一律不得出现「与 HR 对过」的表述。
WCA_HR_INTERVIEWEES=
# TODO【填：目标投递日期 B6】——用于反推 P5 文档必须在哪一天前完成
WCA_TARGET_APPLY_DATE=
